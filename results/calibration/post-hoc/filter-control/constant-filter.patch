+# ---------------------------------------------------------------- EXPLORATORY: the constant column filter
+# A local patch of a scratch worktree, never merged: a post hoc control on a split that is not `test`. With
+# BENCH_CONST_FILTER=No|Yes, `bench run --arm B5` answers every `filter_column` invocation with that constant
+# and calls no model for it; every other call site is routed as B5 routes it.
+
+CONST_FILTER_ENV = "BENCH_CONST_FILTER"
+CONST_FILTER_CLUSTER_ENV = "BENCH_CONST_FILTER_CLUSTER"  # the cluster whose adapter the run then never calls
+CONST_FILTER_SITE = "filter_column"
+CONST_FILTER_ANSWERS = ("No", "Yes")  # drop the column, keep the column (CHESS: `.lower() == "yes"` keeps)
+
+
+def const_filter_engine(answer: str) -> str:
+    return f"const:{answer}"
+
+
+def const_filter_text(answer: str) -> str:
+    """The constant's raw text: the JSON object CHESS's template asks the model for (template_filter_column.txt),
+    which the call site's own parser reads into {"chain_of_thought_reasoning": ..., "is_column_information_relevant": answer}."""
+    return json.dumps({"chain_of_thought_reasoning": f"constant answer ({CONST_FILTER_ENV}={answer}): no model was called",
+                       "is_column_information_relevant": answer})
+
+
+def _constant_filter(run: _RunState, invocation_key: str, lc_messages: List[Any], parser: Any) -> Any:
+    """One `filter_column` invocation answered by the run's constant: the same checks as a routed call (a failed
+    run, the question, the repetition suffix), no router (nothing is embedded: no cluster, no routes line), no
+    engine, and one C1 line: engine `const:<answer>`, the prompt CHESS wrote (never sent), the constant's text
+    and what CHESS's parser makes of it, zero tokens (`estimated`: nothing was billed), a latency of 0.
+    `model_role` and `endpoint` are C1's closed sets: `slm` (the role the constant stands in for) and `fake`."""
+    from langchain_core.messages import AIMessage
+    call_site, answer = CONST_FILTER_SITE, run.const_filter
+    _refuse_if_failed(run, call_site)
+    if run.question_id is None:
+        raise HarnessError("hooks.set_question() was not called for this question")
+    with run.lock:
+        n = run.occurrences.get((call_site, invocation_key), 0) + 1
+        run.occurrences[(call_site, invocation_key)] = n
+    key = invocation_key if n == 1 else f"{invocation_key}@{n}"
+    engine = const_filter_engine(answer)
+    output = AIMessage(content=const_filter_text(answer))
+    parsed = _harness(call_site, lambda: parser.invoke(output))
+    if not isinstance(parsed, dict) or parsed.get("is_column_information_relevant") != answer:
+        raise HarnessError(f"{call_site}: the parser read the constant {answer!r} as {parsed!r}")
+    _harness(call_site, lambda: _record(
+        call_id=str(uuid.uuid4()), retry_of=None, attempt=1, call_site=call_site, invocation_key=key,
+        chosen=Route(engine, None), messages=_message_dicts(lc_messages),
+        started_at=datetime.now(timezone.utc).isoformat(), latency_ms=0,
+        temperature=float(_config["call_sites"][call_site]["temperature"]), output=output, parsed=parsed,
+        parsed_ok=True, error=None,
+        spec={"model_role": "slm", "model": engine, "endpoint": {"kind": "fake"}},
+        usage={"input": 0, "cached_input": 0, "output": 0, "reasoning": 0, "source": "estimated"}))
+    return parsed
+
+
 def invoke_agent_call(call_site: str, invocation_key: str, message: str, parse: Callable[[str], Any]) -> str:
     """The agent's next-tool choice: one answer, as in CHESS (transport failures are retried).
     `parse` is the agent's own reading of the response; the agent raises on it itself."""
