# reference clones and local environments
.ref/
.venv*/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.env

# large or licensed inputs, regenerated by `bench data` (hashes live in data/MANIFEST.json)
# (no trailing slash: in a worktree these are symlinks to the main checkout's data)
data/raw
data/bird_dev
data/models


# run outputs (facts); test-split registry entries are committed explicitly
runs/

# S5: adapters (weights, ~100 MB each) and their datasets (teacher outputs: not published by default,
# since the provider's terms decide whether they may be)
train/adapters/
train/datasets/
*.egg-info/

# generated reports (bench report): regenerated from judgments, never edited by hand
reports/

# RunPod: what this machine created there (pods, volume, tunnels) and the pods' host keys (runpod_apps/state.py)
.runpod/

# Claude Code (local settings and worktrees): never run code, kept out of git status for the test barrier
.claude/
